# Database
DATABASE_URL=postgresql://agentos:agentos_password@localhost:5432/agentos

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI Providers (Choose one)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here

# Default LLM Model
DEFAULT_MODEL=openai/gpt-4-turbo-preview

# JWT Settings
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser Automation
BROWSER_USE_API_KEY=your_browser_use_key_here
PLAYWRIGHT_BROWSERS_PATH=/tmp/browsers

# Docker Sandbox
DOCKER_SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=300

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_YOUTUBE_AUTOMATION=false
ENABLE_CODE_EXECUTION=true
ENABLE_BROWSER_AUTOMATION=true
