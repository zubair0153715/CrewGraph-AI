# .gitignore for CrewGraph Sales OS

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Database (SQLite)
*.db
*.sqlite
*.sqlite3
data/*.db

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Frontend (Next.js)
frontend/.next/
frontend/node_modules/
frontend/out/

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# Temporary files
tmp/
temp/
*.tmp

# Credentials (keep example files, ignore actual keys)
!*.example
credentials.json
service_account.json
