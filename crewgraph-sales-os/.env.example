# Environment Configuration for CrewGraph Sales OS

# Get FREE Groq API Key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Database (SQLite for local dev, PostgreSQL for production)
# SQLite (default - no setup needed)
DATABASE_URL=sqlite:///./data/crewgraph.db

# PostgreSQL (optional - for production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Qdrant Vector DB (optional - for advanced memory)
# Get free cluster: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# Authentication
SECRET_KEY=change-this-to-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email Configuration (optional - for sending emails)
# Gmail API (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# OR SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# LLM Settings
LLM_MODEL=llama3-70b-8192
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Sending Limits (start conservative)
DAILY_EMAIL_LIMIT=100
EMAIL_BATCH_SIZE=10

# Debug Mode
DEBUG=True
